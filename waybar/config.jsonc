/***
 *    ┓ ┏┏┓┓┏┳┓┏┓┳┓  ┏┓┏┓┳┓┏┓┳┏┓
 *    ┃┃┃┣┫┗┫┣┫┣┫┣┫━━┃ ┃┃┃┃┣ ┃┃┓
 *    ┗┻┛┛┗┗┛┻┛┛┗┛┗  ┗┛┗┛┛┗┻ ┻┗┛
 *
 */

// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "fixed-center": true,
    "gtk-layer-shell": true,
    "spacing": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "modules-left": [
        "custom/power_menu",
        "hyprland/workspaces",
        "idle_inhibitor",
        "custom/pacman_icon",
        "custom/pacman_updates_count",
        "custom/weather_icon",
        "custom/weather_temp",
        "custom/colorpicker"
    ],
    "modules-center": ["tray"],
    "modules-right": [
        "network#icon",
        "network#address",
        "wireplumber#icon",
        "wireplumber#volume",
        "backlight#icon",
        "backlight#percent",
        "battery#icon",
        "battery#capacity",
        "clock#icon",
        "clock#time",
        "custom/swaync"
    ],
    "custom/power_menu": {
        "format": "\ue60e",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/power_menu.xml",
        "menu-actions": {
            "shutdown": "hyprctl clients -j | jq -r '.[].pid' | xargs kill ; systemctl poweroff",
            "reboot": "hyprctl clients -j | jq -r '.[].pid' | xargs kill ; systemctl reboot",
            "suspend": "systemctl suspend",
            "lock": "loginctl lock-session"
        }
    },
    "hyprland/workspaces": {
        "format": "{id}"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "\ue9f6",
            "deactivated": "\ue9f5"
        },
        "tooltip-format-activated": "Idle inhibit activated",
        "tooltip-format-deactivated": "Idle inhibit deactivated"
    },
    "group/network-modules": {
        "modules": ["network#icon", "network#address"],
        "orientation": "inherit"
    },
    "network#icon": {
        "format-disconnected": "\uf239",
        "format-ethernet": "\uefe6",
        "format-wifi": "\uef16",
        "tooltip-format-wifi": "WiFi: {essid} ({signalStrength}%)\n󰅃 {bandwidthUpBytes} 󰅀 {bandwidthDownBytes}",
        "tooltip-format-ethernet": "Ethernet: {ifname}\n󰅃 {bandwidthUpBytes} 󰅀 {bandwidthDownBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "hyprctl dispatch exec '[float on; center on; size 1100 800]' '$TERMINAL --adjust-cell-height=0% -e impala'"
    },
    "network#address": {
        "format-disconnected": "Disconnected",
        "format-ethernet": "{ipaddr}/{cidr}",
        "format-wifi": "{essid}",
        "tooltip-format-wifi": "WiFi: {essid} ({signalStrength}%)\n󰅃 {bandwidthUpBytes} 󰅀 {bandwidthDownBytes}",
        "tooltip-format-ethernet": "Ethernet: {ifname}\n󰅃 {bandwidthUpBytes} 󰅀 {bandwidthDownBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "hyprctl dispatch exec '[float on; center on; size 1100 800]' '$TERMINAL --adjust-cell-height=0% -e impala'"
    },
    "wireplumber#icon": {
        "format": "{icon}",
        "format-muted": "\ue04f",
        "format-icons": ["\ue04e", "\ue04d", "\ue050"],
        "on-click": "hyprctl dispatch exec '[float]' '$TERMINAL --adjust-cell-height=0% -e wiremix'",
        "on-scroll-up": "wpctl set-volume -l '1.0' @DEFAULT_AUDIO_SINK@ 1%+ &> /dev/null",
        "on-scroll-down": "wpctl set-volume -l '1.0' @DEFAULT_AUDIO_SINK@ 1%- &> /dev/null",
        "tooltip-format": "Volume: {volume}%",
        "on-click": "hyprctl dispatch exec '[float on; center on; size 1100 800]' '$TERMINAL --adjust-cell-height=0% -e wiremix'"
    },
    "wireplumber#volume": {
        "format": "{volume}%",
        "tooltip-format": "Volume: {volume}%",
        "on-click": "hyprctl dispatch exec '[float on; center on; size 1100 800]' '$TERMINAL --adjust-cell-height=0% -e wiremix'",
        "on-scroll-up": "wpctl set-volume -l '1.0' @DEFAULT_AUDIO_SINK@ 1%+ &> /dev/null",
        "on-scroll-down": "wpctl set-volume -l '1.0' @DEFAULT_AUDIO_SINK@ 1%- &> /dev/null"
    },
    "backlight#icon": {
        "format": "{icon}",
        "format-icons": [
            "\uf7e8",
            "\uf726",
            "\uf725",
            "\uf724",
            "\uf723",
            "\uf722",
            "\uf721",
            "\ue3ac"
        ],
        "on-scroll-up": "brightnessctl set 1%+ &> /dev/null",
        "on-scroll-down": "brightnessctl set 1%- &> /dev/null",
        "tooltip-format": "Backlight: {percent}%"
    },
    "backlight#percent": {
        "format": "{percent}%",
        "tooltip-format": "Backlight: {percent}%"
    },

    "battery#icon": {
        "format": "{icon}",
        "format-charging": "\uf250",
        "format-plugged": "\uf250",
        "format-icons": [
            "\uf306",
            "\uf30b",
            "\uf30a",
            "\uf309",
            "\uf308",
            "\uf307",
            "\uf304"
        ],
        "states": {
            "warning": 30,
            "critical": 15
        },
        "tooltip-format-charging": "<span font_family='Material Symbols Rounded' size='14pt' rise='-4500'>battery_android_frame_bolt</span> {capacity}% , {power:>1.0f}W",
        "tooltip-format-discharging": "<span font_family='Material Symbols Rounded' size='14pt' rise='-4500'>battery_android_frame_5</span> {capacity}% , {power:>1.0f}W",
        "tooltip-format-plugged": "<span font_family='Material Symbols Rounded' size='14pt' rise='-4500'>charger</span> {capacity}% , {timeTo}"
    },
    "battery#capacity": {
        "format": "{capacity}%",
        "tooltip-format-charging": "<span font_family='Material Symbols Rounded' size='14pt' rise='-4500'>battery_android_frame_bolt</span> {capacity}% , {power:>1.0f}W",
        "tooltip-format-discharging": "<span font_family='Material Symbols Rounded' size='14pt' rise='-4500'>battery_android_frame_5</span> {capacity}% , {power:>1.0f}W",
        "tooltip-format-plugged": "<span font_family='Material Symbols Rounded' size='14pt' rise='-4500'>charger</span> {capacity}% , {timeTo}"
    },
    "tray": {
        "icon-size": 14,
        "spacing": 10,
        "show-passive-items": true
    },
    "clock#icon": {
        "actions": {
            "on-scroll-down": "shift_down",
            "on-scroll-up": "shift_up"
        },
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "left",
            "format": {
                "months": "<span font='Intel One Mono 12' color='#c09d59'><b>{}</b></span>",
                "days": "<span font='Intel One Mono 12' color='#e5c9a0'><b>{}</b></span>",
                "weeks": "<span font='Intel One Mono 12' color='#7f91b2'><b>W{}</b></span>",
                "weekdays": "<span font='Intel One Mono 12' color='#7b9695'><b>{}</b></span>",
                "today": "<span font='Intel One Mono 12' color='#c09d59'><b>{}</b></span>"
            }
        },
        "format": "\uf6b8",
        "tooltip-format": "{calendar}"
    },
    "clock#time": {
        "actions": {
            "on-scroll-down": "shift_down",
            "on-scroll-up": "shift_up"
        },
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "left",
            "format": {
                "months": "<span font='Intel One Mono 12' color='#c09d59'><b>{}</b></span>",
                "days": "<span font='Intel One Mono 12' color='#e5c9a0'><b>{}</b></span>",
                "weeks": "<span font='Intel One Mono 12' color='#7f91b2'><b>W{}</b></span>",
                "weekdays": "<span font='Intel One Mono 12' color='#7b9695'><b>{}</b></span>",
                "today": "<span font='Intel One Mono 12' color='#c09d59'><b>{}</b></span>"
            }
        },
        "format": "{:%I:%M %p}",
        "tooltip-format": "{calendar}"
    },
    "custom/pacman_icon": {
        "format": "\uf5f4",
        "on-click": "$TERMINAL -e yay; pkill -SIGRTMIN+8 waybar",
        "tooltip-format": "Click to perform update"
    },
    "custom/pacman_updates_count": {
        "interval": 3600,
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/pacman-updates.sh",
        "exec-if": "exit 0",
        "on-click": "$TERMINAL -e yay; pkill -SIGRTMIN+8 waybar",
        "signal": 8
    },
    "custom/colorpicker": {
        "format": "{}",
        "return-type": "json",
        "interval": "once",
        "exec": "~/.config/waybar/scripts/colorpicker.sh -j",
        "on-click": "~/.config/waybar/scripts/colorpicker.sh",
        "signal": 1
    },
    "custom/swaync": {
        "tooltip": true,
        "tooltip-format": "Left Click: Launch Notification Center\nRight Click: Do not Disturb",
        "format": "{icon}",
        "format-icons": {
            "notification": "\uf4fe",
            "none": "\ue7f4",
            "dnd-notification": "\ue7f6",
            "dnd-none": "\ue7f6",
            "inhibited-notification": "\uf4fe",
            "inhibited-none": "\ue7f4",
            "dnd-inhibited-notification": "\ue7f6",
            "dnd-inhibited-none": "\ue7f6"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "sleep 0.1 && swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "custom/weather_icon": {
        "format": "{}",
        "format-alt": "{alt}: {}",
        "format-alt-click": "click",
        "interval": 3600,
        "return-type": "json",
        "exec": "$HOME/.config/waybar/scripts/weather.py icon",
        "tooltip": true
    },
    "custom/weather_temp": {
        "format": "{}",
        "format-alt": "{alt}: {}",
        "format-alt-click": "click",
        "interval": 3600,
        "return-type": "json",
        "exec": "$HOME/.config/waybar/scripts/weather.py temp",
        "tooltip": true
    }
}
