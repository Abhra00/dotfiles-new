#!/usr/bin/env python3

import os

# This script needs to run inside a terminal that supports images
gif_path="~/.local/share/asset.gif"

# ANSI escape codes for text styling
RED = '\033[91m'
GREEN = '\033[92m'
YELLOW = '\033[93m'
BLUE = '\033[94m'
MAGENTA = '\033[95m'
CYAN = '\033[96m'
BOLD = '\033[1m'
ITALIC = '\033[3m'
RESET = '\033[0m'

def print_centered(text, color='', bold=False, italic=False):
    terminal_width = os.get_terminal_size().columns

    style = ""
    if bold:
        style += BOLD
    if italic:
        style += ITALIC

    print(f"{style}{color}"+('{:^'+str(terminal_width)+'}').format(text)+RESET)

os.system('tput clear')

os.system(f'chafa -f kitty --fg-only --size=x10 --align top,mid -d 2 {gif_path}')
print_centered('PERIHELION', bold=True, color=BLUE)
# Remember every kanji character 2 character widths
print_centered('近日点   ', color=CYAN)
print_centered('περί ("near") + ήλιος ("sun")', color=YELLOW)
print()
print_centered('The point in a celestial body\'s orbit')
print_centered('closest to the Sun.')
print()
print_centered('farthest from void', color=MAGENTA, italic=True)
print_centered('closest to light', color=MAGENTA, italic=True)
print()
