# Color prompt
force_color_prompt=yes
color_prompt=yes

# Set git prompt variables
GIT_PS1_SHOWDIRTYSTATE=1         # show * for unstaged, + for staged changes
GIT_PS1_SHOWUNTRACKEDFILES=1     # show % for untracked files
GIT_PS1_SHOWSTASHSTATE=1         # show $ if stash exists
GIT_PS1_SHOWUPSTREAM="auto"      # ahead/behind remote status

# Prompt
PS1=$'\n'\
'\[\e[94m\][\[\e[93m\]\u\[\e[91m\]@\[\e[94m\]\h\[\e[0m\] \W'\
'\[\e[93m\]$(__git_ps1 " %s")'\
'\[\e[94m\]]'\
'\[$(if (( $? == 0 )); then printf "\e[97m"; else printf "\e[91m"; fi)\]$\[\e[0m\] '
