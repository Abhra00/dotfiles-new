set notification-fg               "#efd5c5"
set completion-bg                 "#2e2a31"
set completion-fg                 "#7fce5f"
set completion-group-bg           "#232025"
set completion-group-fg           "#efd5c5"
set completion-highlight-bg       "#80aadf"
set completion-highlight-fg       "#232025"
set inputbar-bg                   "#232025"
set inputbar-fg                   "#efd5c5"
set statusbar-bg                  "#232025"
set statusbar-fg                  "#efd5c5"
set highlight-color               "#c0b24f"
set highlight-active-color        "#ffaacf"
set default-bg                    "#232025"
