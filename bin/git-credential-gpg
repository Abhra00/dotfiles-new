#!/usr/bin/env bash

# Git calls the helper with an argument like "get", "store", or "erase"
# We only want to output credentials when Git asks to "get" them.
if [ "$1" = "get" ]; then
  echo "username=Abhra00"
  echo "password=$(gpg --quiet --decrypt "$HOME/.local/share/tokens/github_token.gpg")"
fi
