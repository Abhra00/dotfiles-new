# Font families
font-family = "Source Code Pro"
font-family-bold = "Source Code Pro"
font-family-italic = "Source Code Pro"
font-family-bold-italic = "Source Code Pro"
font-family = "Symbols Nerd Font Mono"

# Cell height
adjust-cell-height = 30%

# Font size
font-size = 10

# Underline position
adjust-underline-position = 6

# Mouse
mouse-hide-while-typing = true
mouse-scroll-multiplier = 1

# Theme
theme = Lunaris
background-opacity = 1.0
window-theme = ghostty

# Cursor
cursor-style = "block"
adjust-cursor-thickness = 140%
adjust-cursor-height = 30%
cursor-style-blink = true

# keybindings
keybind = clear
keybind = alt+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:bottom
keybind = ctrl+shift+k=goto_split:top
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+up=adjust_selection:up
keybind = ctrl+down=adjust_selection:down
keybind = ctrl+left=adjust_selection:left
keybind = ctrl+right=adjust_selection:right
keybind = alt+shift+t=new_tab
keybind = alt+shift+h=previous_tab
keybind = alt+shift+l=next_tab
keybind = alt+shift+comma=move_tab:-1
keybind = alt+shift+period=move_tab:1
keybind = alt+shift+c=copy_to_clipboard
keybind = alt+shift+v=paste_from_clipboard
keybind = alt+shift+enter=new_split:auto
keybind = alt+shift+i=inspector:toggle
keybind = alt+shift+m=toggle_split_zoom
keybind = alt+shift+r=reload_config
keybind = alt+shift+s=write_screen_file:open
keybind = alt+shift+w=close_surface
keybind = alt+shift+page_up=increase_font_size:1
keybind = alt+shift+page_down=decrease_font_size:1
keybind = page_down=scroll_page_down
keybind = page_up=scroll_page_up
keybind = alt+x=jump_to_prompt:1
keybind = alt+z=jump_to_prompt:-1
keybind = alt+enter=toggle_quick_terminal
keybind = alt+backquote=toggle_command_palette

# Window
gtk-single-instance = true
gtk-tabs-location = bottom
gtk-wide-tabs = false
gtk-toolbar-style = flat
window-padding-x = 5,5
window-padding-y = 5,5
window-padding-balance = true
window-decoration = false

# Other
window-inherit-working-directory = false
copy-on-select = clipboard
shell-integration-features = no-cursor,sudo,no-title,ssh-env
app-notifications = no-clipboard-copy
