# Options
set recolor                       true
set recolor-keephue               true
set window-title-home-tilde       true
set statusbar-basename            true
set selection-clipboard           clipboard
set render-loading                true
set database                      null
set adjust-open                   width
set smooth-scroll                 true
set show-v-scrollbar              true
set window-title-basename         true

# Keymaps
map u                             scroll half-up
map d                             scroll half-down
map D                             toggle_page_mode
map r                             reload
map R                             rotate
map K                             zoom in
map J                             zoom out
map i                             recolor
map p                             print
map g                             goto top
map [fullscreen] u                scroll half-up
map [fullscreen] d                scroll half-down
map [fullscreen] D                toggle_page_mode
map [fullscreen] r                reload
map [fullscreen] R                rotate
map [fullscreen] K                zoom in
map [fullscreen] J                zoom out
map [fullscreen] i                recolor
map [fullscreen] p                print
map [fullscreen] g                goto top
map <C-i>                         recolor

# Kintsukoroi Colors
set notification-error-bg         "#c06c5c" # red
set notification-error-fg         "#141210" # bg
set notification-warning-bg       "#c09d59" # yellow
set notification-warning-fg       "#141210" # bg
set notification-bg               "#141210" # bg
set notification-fg               "#e5c9a0" # fg
set completion-bg                 "#1a1714" # slightly lighter bg
set completion-fg                 "#85b695" # bright_green
set completion-group-bg           "#141210" # bg
set completion-group-fg           "#e5c9a0" # fg
set completion-highlight-bg       "#a3a9ce" # bright_blue
set completion-highlight-fg       "#141210" # bg
set inputbar-bg                   "#141210" # bg
set inputbar-fg                   "#e5c9a0" # fg
set statusbar-bg                  "#141210" # bg
set statusbar-fg                  "#e5c9a0" # fg
set highlight-color               "#c09d59" # yellow
set highlight-active-color        "#d88095" # pink
set default-bg                    "#141210" # bg
set default-fg                    "#e5c9a0" # fg
set render-loading                true
set render-loading-fg             "#141210" # bg
set render-loading-bg             "#e5c9a0" # fg
set recolor-lightcolor            "#141210" # bg
set recolor-darkcolor             "#e5c9a0" # fg
