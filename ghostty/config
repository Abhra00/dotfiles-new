# Fonts
font-family = "Mononoki Nerd Font"
font-family = "Symbols Nerd Font Mono"
font-size = 14
adjust-cell-height = 30%
adjust-underline-position = 4

# Mouse
mouse-hide-while-typing = true

# Theme
theme = tokyonight
cursor-invert-fg-bg = true
background-opacity = 0.97
window-theme = ghostty

# Cursor
cursor-style = "block"
adjust-cursor-thickness = 120%
adjust-cursor-height = 40%
cursor-style-blink = true

# keybindings
keybind = clear
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:bottom
keybind = ctrl+shift+k=goto_split:top
keybind = ctrl+shift+l=goto_split:right
keybind = alt+shift+t=new_tab
keybind = alt+shift+h=previous_tab
keybind = alt+shift+l=next_tab
keybind = alt+shift+comma=move_tab:-1
keybind = alt+shift+period=move_tab:1
keybind = alt+shift+c=copy_to_clipboard
keybind = alt+shift+v=paste_from_clipboard
keybind = alt+shift+enter=new_split:auto
keybind = alt+shift+i=inspector:toggle
keybind = alt+shift+m=toggle_split_zoom
keybind = alt+shift+r=reload_config
keybind = alt+shift+s=write_screen_file:open
keybind = alt+shift+w=close_surface
keybind = alt+shift+page_up=increase_font_size:1
keybind = alt+shift+page_down=decrease_font_size:1
keybind = alt+z=jump_to_prompt:-1
keybind = alt+x=jump_to_prompt:1

# Window
gtk-single-instance = true
gtk-tabs-location = bottom
gtk-wide-tabs = false
gtk-toolbar-style = flat
window-padding-x = 20
window-padding-y = 20
window-padding-balance = true
window-decoration = false

# Shaders
custom-shader-animation = always
custom-shader = "shaders/cursor_warp.glsl"
custom-shader = "shaders/sonic_boom_cursor.glsl"

# Other
window-inherit-working-directory = false
copy-on-select = clipboard
shell-integration-features = no-cursor,sudo,no-title,ssh-env
app-notifications = no-clipboard-copy
