/*--------Color definitions------------*/
* {
       background:                 #000000;
       background-alpha:           #000000d3;
       background-alt:             #191724;
       background-alt-alpha:       #191724d3;
       foreground:                 #e0def4;
       border-color:               #c4a7e7;
       selected:                   #ebbcba;
       selected-alpha:             #ebbcbad3;
       selected-text:              #000000;
       active:                     #31748f;
       urgent:                     #eb6f92;
}
