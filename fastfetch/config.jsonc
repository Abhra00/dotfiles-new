/**
 *    ┏┓┏┓┏┓┏┳┓┏┓┏┓┏┳┓┏┓┓┏
 *    ┣ ┣┫┗┓ ┃ ┣ ┣  ┃ ┃ ┣┫
 *    ┻ ┛┗┗┛ ┻ ┻ ┗┛ ┻ ┗┛┛┗
 *
 */
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "~/.config/fastfetch/pics/yuji.png",
        "height": 10,
        "padding": {
            "top": 0,
            "right": 2,
            "bottom": 2
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        "break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "31"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "32"
        },
        {
            "type": "packages",
            "format": "{}",
            "key": " ",
            "keyColor": "33"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "35"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "36"
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "31"
        },
        {
            "type": "media",
            "key": "󰝚 ",
            "keyColor": "32"
        },
        {
            "type": "command",
            "key": " ",
            "shell": "/bin/bash",
            "text": "echo '名誉を失う前に死ぬ'",
            "format": "{1}",
            "outputColor": "36"
        },
        "break"
    ]
}
