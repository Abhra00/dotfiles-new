# Options
set recolor                       true
set recolor-keephue               true
set window-title-home-tilde       true
set statusbar-basename            true
set selection-clipboard           clipboard
set render-loading                true
set database                      null
set adjust-open                   width
set smooth-scroll                 true
set show-v-scrollbar              true
set window-title-basename         true

# Keymaps
map u                             scroll half-up
map d                             scroll half-down
map D                             toggle_page_mode
map r                             reload
map R                             rotate
map K                             zoom in
map J                             zoom out
map i                             recolor
map p                             print
map g                             goto top
map [fullscreen] u                scroll half-up
map [fullscreen] d                scroll half-down
map [fullscreen] D                toggle_page_mode
map [fullscreen] r                reload
map [fullscreen] R                rotate
map [fullscreen] K                zoom in
map [fullscreen] J                zoom out
map [fullscreen] i                recolor
map [fullscreen] p                print
map [fullscreen] g                goto top
map <C-i>                         recolor

# Colors
set notification-error-bg         "#dd6e6b" # Red
set notification-error-fg         "#f6f6f5" # Foreground
set notification-warning-bg       "#e8eda2" # Yellow
set notification-warning-fg       "#233440" # Selection
set notification-bg               "#0e151a" # Background
set notification-fg               "#f6f6f5" # Foreground
set completion-bg                 "#151f26" # Background
set completion-fg                 "#87e58e" # Comment/Green
set completion-group-bg           "#0e151a" # Background
set completion-group-fg           "#f6f6f5" # Comment/Foreground
set completion-highlight-bg       "#baa0e8" # Selection/Blue
set completion-highlight-fg       "#233440" # Foreground
set inputbar-bg                   "#0e151a" # Background
set inputbar-fg                   "#f6f6f5" # Foreground
set statusbar-bg                  "#0e151a" # Background
set statusbar-fg                  "#f6f6f5" # Foreground
set highlight-color               "#e8eda2" # Yellow
set highlight-active-color        "#e48cc1" # Pink
set default-bg                    "#0e151a" # Background
set default-fg                    "#f6f6f5" # Foreground
set render-loading                true
set render-loading-fg             "#0e151a" # Background
set render-loading-bg             "#f6f6f5" # Foreground

# Recolor mode settings
set recolor-lightcolor            "#0e151a" # Background
set recolor-darkcolor             "#f6f6f5" # Foreground
