# A Simple yet elegant starship config
# Created by BUGS

# Schema
"$schema" = 'https://starship.rs/config-schema.json'

# Options
add_newline = true
command_timeout = 200

# Palette
palette = "lunaris"

# Prompt format
format = """
$character\
$directory"""

# Character
[character]
error_symbol = "[ λ ](bold bg:bright_red fg:foreground_inverse)"
success_symbol = "[ λ ](bold bg:bright_green fg:foreground_inverse)"
vimcmd_symbol = "[ λ ](bold bg:bright_magenta fg:foreground_inverse)"
vimcmd_visual_symbol = "[ λ ](bold bg:bright_blue fg:foreground_inverse)"
vimcmd_replace_symbol = "[ λ ](bold bg:bright_yellow fg:foreground_inverse)"
vimcmd_replace_one_symbol = "[ λ ](bold bg:bright_yellow fg:foreground_inverse)"
format = '$symbol'

# Directory
[directory]
style = 'bg:bright_black fg:blue'
read_only_style = 'bg:bright_black fg:red'
home_symbol = 'home'
read_only = ' '
truncation_length = 2
truncation_symbol = '…/'
truncate_to_repo = false
format = '[ $path ]($style)[$read_only]($read_only_style)[▓▒░](fg:bright_black) '


  # Luanris colors
[palettes.lunaris]
# 8 normal colors
black = '#151f26'
red = '#dd6e6b'
green = '#87e58e'
yellow = '#e8eda2'
blue = '#baa0e8'
magenta = '#e48cc1'
cyan = '#a7dfef'
white = '#e6e6e5'
bright_black = '#233440'
bright_red = '#e1837f'
bright_green = '#97eda2'
bright_yellow = '#f6f6b6'
bright_blue = '#d0b5f3'
bright_magenta = '#e7a1d7'
bright_cyan = '#bcf4f5'
bright_white = '#ffffff'
foreground = '#f6f6f5'
background = '#0e151a'
foreground_inverse = '#0e151a'
