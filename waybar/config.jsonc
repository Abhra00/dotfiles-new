/***
 *    ┓ ┏┏┓┓┏┳┓┏┓┳┓  ┏┓┏┓┳┓┏┓┳┏┓
 *    ┃┃┃┣┫┗┫┣┫┣┫┣┫━━┃ ┃┃┃┃┣ ┃┃┓
 *    ┗┻┛┛┗┗┛┻┛┛┗┛┗  ┗┛┗┛┛┗┻ ┻┗┛
 *
 */

// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "fixed-center": true,
    "gtk-layer-shell": true,
    "spacing": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "modules-left": [
        "power-profiles-daemon",
        "hyprland/workspaces",
        "idle_inhibitor",
        "custom/pacman_icon",
        "custom/pacman_updates_count",
        "custom/weather_icon",
        "custom/weather_temp",
        "custom/colorpicker",
	"privacy"
    ],
    "modules-center":[ "custom/music" ],
    "modules-right": [
        "network#icon",
        "network#address",
        "wireplumber#icon",
        "wireplumber#volume",
        "backlight#icon",
        "backlight#percent",
        "battery#icon",
        "battery#capacity",
        "clock#icon",
        "clock#time",
        "group/tray-group"
    ],
    "power-profiles-daemon": {
	"format": "{icon}",
	"tooltip-format": "Power profile: {profile}\nDriver: {driver}",
	"tooltip": true,
	"format-icons": {
	    "default": "\ue2ae",
	    "performance": "\ue2ae",
	    "balanced": "\ueaf6",
	    "power-saver": "\uec1a"
	}
    },
    "hyprland/workspaces": {
        "format": "{id}"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "\ue9f6",
            "deactivated": "\ue9f5"
        },
        "tooltip-format-activated": "<span font_family='Material Symbols Rounded' size='14pt' rise='-4500'>visibility</span> Idle inhibit activated",
        "tooltip-format-deactivated": "<span font_family='Material Symbols Rounded' size='14pt' rise='-4500'>visibility_off</span> Idle inhibit deactivated"
    },
    "network#icon": {
        "interval": 3,
        "format-disconnected": "\uf0ef",
        "format-ethernet": "\uefe6",
        "format-wifi": "{icon}",
        "format-icons": ["\uf58f", "\uf58e", "\uf58d", "\uf532"],
        "tooltip-format-wifi": "WiFi: {essid} [{signalStrength}% | {frequency} GHz]",
        "tooltip-format-ethernet": "Ethernet: {ifname}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click-middle": "hyprctl dispatch exec '[float on; center on; size 1100 800]' '$TERMINAL --adjust-cell-height=0% -e impala'"
    },
    "network#address": {
        "interval": 3,
        "format-disconnected": "DISCONNECTED",
        "format-ethernet": "CONNECTED",
        "format-wifi": "CONNECTED",
        "format-alt": "<span font_family='Material Symbols Rounded' size='12pt' rise='-3500'>arrow_upload_progress</span> {bandwidthUpBytes} <span font_family='Material Symbols Rounded' size='12pt' rise='-3500'>downloading</span> {bandwidthDownBytes}",
        "tooltip-format-wifi": "WiFi: {essid} [{signalStrength}% | {frequency} GHz]",
        "tooltip-format-ethernet": "Ethernet: {ifname}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click-middle": "hyprctl dispatch exec '[float on; center on; size 1100 800]' '$TERMINAL --adjust-cell-height=0% -e impala'"
    },
    "wireplumber#icon": {
        "format": "{icon}",
        "format-muted": "\ue04f",
        "format-icons": ["\ue04e", "\ue04d", "\ue050"],
        "on-click": "hyprctl dispatch exec '[float]' '$TERMINAL --adjust-cell-height=0% -e wiremix'",
        "on-scroll-up": "wpctl set-volume -l '1.0' @DEFAULT_AUDIO_SINK@ 1%+ &> /dev/null",
        "on-scroll-down": "wpctl set-volume -l '1.0' @DEFAULT_AUDIO_SINK@ 1%- &> /dev/null",
        "tooltip-format": "Volume: {volume}%",
        "on-click": "hyprctl dispatch exec '[float on; center on; size 1100 800]' '$TERMINAL --adjust-cell-height=0% -e wiremix'"
    },
    "wireplumber#volume": {
        "format": "{volume}%",
        "tooltip-format": "Volume: {volume}%",
        "on-click": "hyprctl dispatch exec '[float on; center on; size 1100 800]' '$TERMINAL --adjust-cell-height=0% -e wiremix'",
        "on-scroll-up": "wpctl set-volume -l '1.0' @DEFAULT_AUDIO_SINK@ 1%+ &> /dev/null",
        "on-scroll-down": "wpctl set-volume -l '1.0' @DEFAULT_AUDIO_SINK@ 1%- &> /dev/null"
    },
    "backlight#icon": {
        "format": "{icon}",
        "format-icons": [
            "\uf7e8",
            "\uf726",
            "\uf725",
            "\uf724",
            "\uf723",
            "\uf722",
            "\uf721",
            "\ue3ac"
        ],
        "on-scroll-up": "brightnessctl set 1%+ &> /dev/null",
        "on-scroll-down": "brightnessctl set 1%- &> /dev/null",
        "tooltip-format": "Backlight: {percent}%"
    },
    "backlight#percent": {
        "format": "{percent}%",
        "tooltip-format": "Backlight: {percent}%"
    },

    "battery#icon": {
        "format": "{icon}",
        "format-charging": "\uf250",
        "format-plugged": "\uf250",
        "format-icons": [
            "\uf306",
            "\uf30b",
            "\uf30a",
            "\uf309",
            "\uf308",
            "\uf307",
            "\uf304"
        ],
        "states": {
            "warning": 30,
            "critical": 15
        },
        "tooltip-format-charging": "<span font_family='Material Symbols Rounded' size='14pt' rise='-4500'>battery_android_frame_bolt</span> {capacity}%, {power:>1.0f}W",
        "tooltip-format-discharging": "<span font_family='Material Symbols Rounded' size='14pt' rise='-4500'>battery_android_frame_5</span> {capacity}%, {power:>1.0f}W",
        "tooltip-format-plugged": "<span font_family='Material Symbols Rounded' size='14pt' rise='-4500'>charger</span> {capacity}%, {timeTo}"
    },
    "battery#capacity": {
        "format": "{capacity}%",
        "tooltip-format-charging": "<span font_family='Material Symbols Rounded' size='14pt' rise='-4500'>battery_android_frame_bolt</span> {capacity}%, {power:>1.0f}W",
        "tooltip-format-discharging": "<span font_family='Material Symbols Rounded' size='14pt' rise='-4500'>battery_android_frame_5</span> {capacity}%, {power:>1.0f}W",
        "tooltip-format-plugged": "<span font_family='Material Symbols Rounded' size='14pt' rise='-4500'>charger</span> {capacity}%, {timeTo}"
    },
    "tray": {
        "icon-size": 14,
        "spacing": 10,
        "show-passive-items": true
    },
    "clock#icon": {
        "actions": {
            "on-scroll-down": "shift_down",
            "on-scroll-up": "shift_up"
        },
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "left",
            "format": {
                "months": "<span font='Space Mono 12' color='#c09d59'><b>{}</b></span>",
                "days": "<span font='Space Mono 12' color='#e5c9a0'><b>{}</b></span>",
                "weeks": "<span font='Space Mono 12' color='#7f91b2'><b>W{}</b></span>",
                "weekdays": "<span font='Space Mono 12' color='#7b9695'><b>{}</b></span>",
                "today": "<span font='Space Mono 12' color='#c09d59'><b>{}</b></span>"
            }
        },
        "format": "\uf6b8",
        "tooltip-format": "{calendar}"
    },
    "clock#time": {
        "actions": {
            "on-scroll-down": "shift_down",
            "on-scroll-up": "shift_up"
        },
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "left",
            "format": {
                "months": "<span font='Space Mono 12' color='#c09d59'><b>{}</b></span>",
                "days": "<span font='Space Mono 12' color='#e5c9a0'><b>{}</b></span>",
                "weeks": "<span font='Space Mono 12' color='#7f91b2'><b>W{}</b></span>",
                "weekdays": "<span font='Space Mono 12' color='#7b9695'><b>{}</b></span>",
                "today": "<span font='Space Mono 12' color='#c09d59'><b>{}</b></span>"
            }
        },
        "format": "{:%I:%M %p}",
        "tooltip-format": "{calendar}"
    },
    "custom/pacman_icon": {
        "format": "\uf5f4",
        "on-click": "$TERMINAL -e yay && pkill -SIGRTMIN+8 waybar && notify-send 'Updates' 'Update Completed' -i ~/.config/mako/assets/updates.svg",
        "tooltip-format": "Click to perform update"
    },
    "custom/pacman_updates_count": {
        "interval": 3600,
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/pacman-updates.sh",
        "exec-if": "exit 0",
        "on-click": "$TERMINAL -e yay && pkill -SIGRTMIN+8 waybar && notify-send 'Updates' 'Update Completed' -i ~/.config/mako/assets/updates.svg",
        "signal": 8
    },
    "custom/colorpicker": {
        "format": "{}",
        "return-type": "json",
        "interval": "once",
        "exec": "~/.config/waybar/scripts/colorpicker.sh -j",
        "on-click": "~/.config/waybar/scripts/colorpicker.sh",
        "signal": 1
    },
    "privacy": {
        "icon-spacing": 4,
        "icon-size": 18,
        "transition-duration": 250,
        "modules": [
            {
                "type": "screenshare",
                "tooltip": true,
                "tooltip-icon-size": 24
            },
            {
                "type": "audio-in",
                "tooltip": true,
                "tooltip-icon-size": 24
            }
        ],
        "ignore-monitor": true,
        "ignore": [
            {
                "type": "audio-in",
                "name": "cava"
            }
        ]
    },
    "group/tray-group": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "children-class": "tray-child",
            "transition-left-to-right": true,
	    "click-to-reveal": true
        },
        "modules": [
            "custom/tray-expand-icon",
            "tray"
        ]
    },
    "custom/tray-expand-icon": {
        "format": "\ue15f",
        "tooltip-format":  "Click to expand tray icons"
    },
    "custom/weather_icon": {
        "format": "{}",
        "format-alt": "{alt}: {}",
        "format-alt-click": "click",
        "interval": 3600,
        "return-type": "json",
        "exec": "$HOME/.config/waybar/scripts/weather.py icon",
        "tooltip": true
    },
    "custom/weather_temp": {
        "format": "{}",
        "format-alt": "{alt}",
        "interval": 3600,
        "return-type": "json",
        "exec": "$HOME/.config/waybar/scripts/weather.py temp",
        "tooltip": true
    },
    "custom/music": {
        "exec": "~/.config/waybar/scripts/music.sh",
        "restart-interval": 1,
        "return-type": "json",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "max-length": 40,
	"tooltip": true
    }
}
