#!/usr/bin/env bash

DOWNLOAD_DIR="$HOME/Downloads/Mononoki"

[ -d "$DOWNLOAD_DIR" ] || mkdir "$DOWNLOAD_DIR"

url=$(curl -s https://api.github.com/repos/madmalik/mononoki/releases/latest |
  grep "browser_download_url.*zip" |
  cut -d '"' -f 4)

wget -O mononoki-latest.zip "$url"
unzip -o mononoki-latest.zip -d $DOWNLOAD_DIR

rm mononoki-latest.zip
