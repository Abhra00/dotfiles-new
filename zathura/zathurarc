# Options
set recolor                       true
set recolor-keephue               true
set window-title-home-tilde       true
set statusbar-basename            true
set selection-clipboard           clipboard
set render-loading                true
set database                      null
set adjust-open                   width
set smooth-scroll                 true
set show-v-scrollbar              true
set window-title-basename         true

# Keymaps
map u                             scroll half-up
map d                             scroll half-down
map D                             toggle_page_mode
map r                             reload
map R                             rotate
map K                             zoom in
map J                             zoom out
map i                             recolor
map p                             print
map g                             goto top
map [fullscreen] u                scroll half-up
map [fullscreen] d                scroll half-down
map [fullscreen] D                toggle_page_mode
map [fullscreen] r                reload
map [fullscreen] R                rotate
map [fullscreen] K                zoom in
map [fullscreen] J                zoom out
map [fullscreen] i                recolor
map [fullscreen] p                print
map [fullscreen] g                goto top
map <C-i>                         recolor

# Colors
set notification-error-bg         "#d95762" # Red
set notification-error-fg         "#e2e5e6" # Foreground
set notification-warning-bg       "#f38c61" # Orange
set notification-warning-fg       "#2c3334" # Selection
set notification-bg               "#101314" # Background
set notification-fg               "#e2e5e6" # Foreground
set completion-bg                 "#1c2021" # Background
set completion-fg                 "#6b7280" # Comment
set completion-group-bg           "#101314" # Background
set completion-group-fg           "#e2e5e6" # Comment
set completion-highlight-bg       "#95b7e6" # Selection
set completion-highlight-fg       "#2c3334" # Foreground
set inputbar-bg                   "#101314" # Background
set inputbar-fg                   "#e2e5e6" # Foreground
set statusbar-bg                  "#101314" # Background
set statusbar-fg                  "#e2e5e6" # Foreground
set highlight-color               "#f38c61" # Orange
set highlight-active-color        "#d282d9" # Pink
set default-bg                    "#101314" # Background
set default-fg                    "#e2e5e6" # Foreground
set render-loading                true
set render-loading-fg             "#101314" # Background
set render-loading-bg             "#e2e5e6" # Foreground

# Recolor mode settings
set recolor-lightcolor            "#101314" # Background
set recolor-darkcolor             "#e2e5e6" # Foreground
