/*--------Color definitions------------*/
* {
       background:                 #001419;
       background-alpha:           #001419D3;
       background-alt:             #002C38;
       background-alt-alpha:       #002C38D3;
       foreground:                 #FDF5E2;
       border-color:               #B28500;
       selected:                   #29A298;
       selected-alpha:             #29A298D3;
       selected-text:              #001419;
       active:                     #849900;
       urgent:                     #DB302D;
}
