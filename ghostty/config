# Font families
font-family = "Cascadia Code"
font-family-bold = "Cascadia Code"
font-family-italic = "Cascadia Code"
font-family-bold-italic = "Cascadia Code"
font-family = "Symbols Nerd Font Mono"

# Cell height
adjust-cell-height = 45%

# Font size
font-size = 10

# Underline position
adjust-underline-position = 5

# Mouse
mouse-hide-while-typing = true
mouse-scroll-multiplier = 1

# Theme
theme = Kintsukuroi
background-opacity = 1.0
window-theme = ghostty

# Cursor
cursor-style = "block"
adjust-cursor-height = 45%
adjust-cursor-thickness = 145%
cursor-style-blink = true

# Keybindings
keybind = alt+shift+page_up=increase_font_size:1
keybind = alt+shift+page_down=decrease_font_size:1
keybind = page_down=scroll_page_down
keybind = page_up=scroll_page_up
keybind = alt+x=jump_to_prompt:1
keybind = alt+z=jump_to_prompt:-1
keybind = alt+enter=toggle_quick_terminal
keybind = alt+backquote=toggle_command_palette
keybind = alt+f=start_search

# Shaders
custom-shader = ./shaders/cursor-trail.glsl
custom-shader-animation = always

# Window
gtk-single-instance = true
gtk-tabs-location = bottom
gtk-wide-tabs = false
gtk-toolbar-style = flat
window-padding-x = 10,10
window-padding-y = 10,10
window-padding-balance = true
window-decoration = false

# Other
window-inherit-working-directory = false
copy-on-select = clipboard
shell-integration-features = no-cursor,sudo,no-title,ssh-env
app-notifications = clipboard-copy
