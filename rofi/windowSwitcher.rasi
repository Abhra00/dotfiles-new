/*****----- Configuration -----*****/
configuration {
    modi:                        "window";
    icon-theme: 		 "Fluent-dark";
    application-fallback-icon: 	 "Adwaita";
    show-icons:                  true;
    window-format:               "{w} {n}";
}

/*****----- Global Properties -----*****/
@import "~/.config/rofi/shared/colors.rasi"
@import "~/.config/rofi/shared/fonts.rasi"

/*****----- Main Window -----*****/
window {
    enabled:                     true;
    location:                    center;
    x-offset:                    0;
    y-offset:                    0;
    fullscreen:                  false;
    transparency:                "real";
    cursor:                      "default";
    spacing:                     0px;
    padding:                     0px;
    border:                      2px;
    border-radius:               0px;
    border-color:                @border-color;
    background-color:            transparent;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    children:                    [ "listview" ];
    background-color:            @background-alt;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     6;
    lines:                       1;
    spacing:                     5px;
    padding:                     10px 10px;
    cycle:                       true;
    dynamic:                     false;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                false;
    fixed-columns:               true;
    cursor:                      "default";
    background-color:            transparent;
    text-color:                  @foreground;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     0px;
    padding:                     8px;
    orientation:		 vertical;
    border-radius:               0px;
    cursor:                      pointer;
    background-color:            transparent;
    text-color:                  @foreground;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @background;
}

element selected.active {
    background-color:            @active;
    text-color:                  @background;
}

element-icon {
    size:			 84px;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
    horizontal-align:		 0.5;
    vertical-align:		 0.5;
}

element-text {
    enabled:			 false;
}
