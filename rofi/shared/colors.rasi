/*--------Color definitions------------*/
* {
       background:                 #1E2326;
       background-alpha:           #1E2326d3;
       background-alt:             #272E33;
       background-alt-alpha:       #272E33d3;
       foreground:                 #D3C6AA;
       border-color:               #7FBBB3;
       selected:                   #D699B6;
       selected-alpha:             #D699B6d3;
       selected-text:              #272E23;
       active:                     #A7C080;
       urgent:                     #E67E80;
}
