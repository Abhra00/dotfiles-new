# Options
set recolor                      "true"
set recolor-keephue              "true"
set window-title-home-tilde      true
set statusbar-basename           true
set selection-clipboard          clipboard
set render-loading 		 true
set database                     null
# Keymaps (unchanged)
map u                             scroll half-up
map d                             scroll half-down
map D                             toggle_page_mode
map r                             reload
map R                             rotate
map K                             zoom in
map J                             zoom out
map i                             recolor
map p                             print
map g                             goto top
map [fullscreen] u                scroll half-up
map [fullscreen] d                scroll half-down
map [fullscreen] D                toggle_page_mode
map [fullscreen] r                reload
map [fullscreen] R                rotate
map [fullscreen] K                zoom in
map [fullscreen] J                zoom out
map [fullscreen] i                recolor
map [fullscreen] p                print
map [fullscreen] g                goto top
# --------------------------------------
#           Colors
# --------------------------------------
set notification-error-bg 	 "#DB302D"
set notification-error-fg 	 "#FDF5E2"
set notification-warning-bg 	 "#C94C16"
set notification-warning-fg 	 "#001419"
set notification-bg 		 "#001419"
set notification-fg 		 "#ADB7B7"
set completion-bg 		 "#001419"
set completion-fg 		 "#839395"
set completion-group-bg 	 "#002C38"
set completion-group-fg 	 "#9EABAC"
set completion-highlight-bg 	 "#063540"
set completion-highlight-fg 	 "#FDF5E2"
set inputbar-bg 		 "#002C38"
set inputbar-fg 		 "#ADB7B7"
set statusbar-bg 		 "#001419"
set statusbar-fg 		 "#839395"
set highlight-color 		 "#B28500"
set highlight-active-color 	 "#29A298"
set default-bg 			 "#001419"
set default-fg 			 "#839395"
set render-loading-fg 		 "#001419"
set render-loading-bg 		 "#29A298"
set recolor-lightcolor 		 "#001419"
set recolor-darkcolor 		 "#ADB7B7"
