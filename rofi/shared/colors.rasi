/*--------Color definitions------------*/
* {
       background:                 #1a1b26;
       background-alpha:           #1a1b26d3;
       background-alt:             #414868;
       background-alt-alpha:       #414868d3;
       foreground:                 #c0caf5;
       border-color:               #bb9af7;
       selected:                   #c7a9ff;
       selected-alpha:             #c7a9ffd3;
       selected-text:              #1a1b26;
       active:                     #31748f;
       urgent:                     #ff899d;
}
