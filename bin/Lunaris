#!/usr/bin/env python3

import os
import unicodedata
import subprocess
import re

# This script needs to run inside a terminal that supports images
gif_path="~/.local/share/asset.gif"

# ANSI escape codes for text styling
RED = '\033[91m'
GREEN = '\033[92m'
YELLOW = '\033[93m'
BLUE = '\033[94m'
MAGENTA = '\033[95m'
CYAN = '\033[96m'
BOLD = '\033[1m'
ITALIC = '\033[3m'
RESET = '\033[0m'

def display_width(text):
    """Calculate the actual display width of text (accounting for wide characters)"""
    width = 0
    for char in text:
        if unicodedata.east_asian_width(char) in ('F', 'W'):
            width += 2  # Full-width or Wide characters
        else:
            width += 1
    return width

def print_centered(text, color='', bold=False, italic=False):
    terminal_width = os.get_terminal_size().columns
    style = ""
    if bold:
        style += BOLD
    if italic:
        style += ITALIC
    text_width = display_width(text)
    padding = (terminal_width - text_width) // 2
    print(f"{style}{color}{' ' * padding}{text}{RESET}")

def print_blocks_centered(script_path):
    """Run blocks.sh and center each line of its output"""
    try:
        result = subprocess.run(['bash', os.path.expanduser(script_path)], 
                              capture_output=True, text=True, check=True)
        terminal_width = os.get_terminal_size().columns
        for line in result.stdout.splitlines():
            # Strip ANSI codes to measure actual text width
            plain_text = re.sub(r'\033\[[0-9;]*m|\x1b\[[0-9;]*m', '', line)
            # Remove existing tabs from blocks.sh
            plain_text = plain_text.replace('\t', '')
            text_width = display_width(plain_text)
            padding = (terminal_width - text_width) // 2
            # Remove tabs from the actual line too
            centered_line = line.replace('\t', '')
            print(' ' * padding + centered_line)
    except subprocess.CalledProcessError as e:
        print(f"Error running blocks.sh: {e}")
    except FileNotFoundError:
        print(f"blocks.sh not found at {script_path}")

os.system('tput clear')
os.system(f'chafa -f kitty --fg-only --size=x10 --align top,mid -d 2 {gif_path}')
print_centered('aphelion', bold=True)
print_centered('遠日点', color=CYAN)
print_centered('από ("away") + ήλιος ("sun")', color=YELLOW)
print()
print_centered('The point in a celestial body\'s orbit')
print_centered('farthest from the Sun.')
print()
print_centered('farthest from light', color=MAGENTA, italic=True)
print_centered('closest to void', color=MAGENTA, italic=True)
print()
print_blocks_centered('~/.local/bin/blocks.sh')
