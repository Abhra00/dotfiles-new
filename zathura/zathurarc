#  ┏┓┏┓┏┳┓┓┏┳┳┳┓┏┓┳┓┏┓
#  ┏┛┣┫ ┃ ┣┫┃┃┣┫┣┫┣┫┃
#  ┗┛┛┗ ┻ ┛┗┗┛┛┗┛┗┛┗┗┛
# --------------------------------------
# Options
set recolor                      "true"
set recolor-keephue              "true"
set window-title-home-tilde      true
set statusbar-basename           true
set selection-clipboard          clipboard
set database                     null
# Keymaps (unchanged)
map u                             scroll half-up
map d                             scroll half-down
map D                             toggle_page_mode
map r                             reload
map R                             rotate
map K                             zoom in
map J                             zoom out
map i                             recolor
map p                             print
map g                             goto top
map [fullscreen] u                scroll half-up
map [fullscreen] d                scroll half-down
map [fullscreen] D                toggle_page_mode
map [fullscreen] r                reload
map [fullscreen] R                rotate
map [fullscreen] K                zoom in
map [fullscreen] J                zoom out
map [fullscreen] i                recolor
map [fullscreen] p                print
map [fullscreen] g                goto top
# --------------------------------------
#           Colors
# --------------------------------------
# Background / Foreground
set default-bg                    "#272E33"
set default-fg                    "#D3C6AA"
# Status Bar
set statusbar-fg                  "#D3C6AA"
set statusbar-bg                  "#2E383C"
# Input Bar
set inputbar-bg                   "#2E383C"
set inputbar-fg                   "#D3C6AA"
# Notifications
set notification-bg               "#2E383C"
set notification-fg               "#D3C6AA"
set notification-error-bg         "#2E383C"
set notification-error-fg         "#E67E80"     # everforest red
set notification-warning-bg       "#2E383C"
set notification-warning-fg       "#DBBC7F"     # everforest yellow
# Highlights
set highlight-color               "#7FBBB3"     # everforest blue
set highlight-active-color        "#D699B6"     # everforest magenta
# Completion Menu
set completion-bg                 "#272E33"
set completion-fg                 "#D3C6AA"
set completion-highlight-bg       "#D699B6"     # purple accent
set completion-highlight-fg       "#D3C6AA"
# Recolor (PDF dark mode)
set recolor-lightcolor            "#272E33"
set recolor-darkcolor             "#D3C6AA"
# Fonts / GUI
set font                          "JetBrainsMono Nerd Font"
set guioptions                    none
